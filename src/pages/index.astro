---
import PageLayout from "@layouts/PageLayout.astro";
import HomeContent from "@components/HomeContent.astro";
import { t } from "@lib/i18n";

const currentLang = Astro.url.pathname.startsWith("/fr") ? "fr" : "en";
const metaTitle =
  currentLang === "fr"
    ? "Apprentissage automatique scientifique et modélisation physique"
    : "Scientific machine learning and physics-based modeling";
---

<PageLayout title={metaTitle} description={t("hero.subtitle", currentLang)}>
  <HomeContent />
</PageLayout>
