---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { readingTime } from "@lib/utils";
import BackToPrev from "@components/BackToPrev.astro";
import Link from "@components/Link.astro";

export async function getStaticPaths() {
  // Only generate French project pages from the `fr/` collection entries
  const projects = (await getCollection("projects"))
    .filter(post => !post.data.draft && post.id.startsWith('fr/'))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  return projects.map((project) => ({
    params: { slug: project.slug.replace('fr/', '') },
    props: project,
  }));
}

type Props = CollectionEntry<"projects">;

const project = Astro.props;
const { Content } = await project.render();

// Image hero : utilise `hero` s'il est défini (y compris "" pour la retirer),
// sinon repli sur l'image de carte `image`.
const heroSrc = project.data.hero !== undefined ? project.data.hero : project.data.image;
---

<PageLayout title={project.data.title} description={project.data.description}>
  <Container>
    <div class="animate">
      <BackToPrev href="/fr/projects">
        Retour aux projets
      </BackToPrev>
    </div>
    <div class="space-y-1 my-10">
      <div class="animate flex items-center gap-1.5">
        <div class="font-base text-sm">
          <FormattedDate date={project.data.date} />
        </div>
        &bull;
        <div class="font-base text-sm">
          {readingTime(project.body)}
        </div>
      </div>
      <div class="animate text-2xl font-semibold text-black dark:text-white">
        {project.data.title}
      </div>
      {(project.data.demoURL || project.data.repoURL) && (
        <nav class="animate flex gap-1">
          {project.data.demoURL && (
            <Link href={project.data.demoURL} external>
              demo
            </Link>
          )}
          {project.data.demoURL && project.data.repoURL && (
            <span>/</span>
          )}
          {project.data.repoURL && (
            <Link href={project.data.repoURL} external>
              repo
            </Link>
          )}
        </nav>
      )}
      {project.data.tech && project.data.tech.length > 0 && (
        <div class="animate flex flex-wrap gap-2 pt-3">
          {project.data.tech.map((tech: string) => (
            <span class="text-xs px-2 py-1 rounded bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10">
              {tech}
            </span>
          ))}
        </div>
      )}
    </div>
    {heroSrc && (
      <div class="animate mb-10 rounded-lg overflow-hidden border border-black/10 dark:border-white/10 bg-black/5 dark:bg-white/5 p-6">
        <img
          src={heroSrc}
          alt={project.data.title}
          class="w-full max-h-[24rem] object-contain"
        />
      </div>
    )}
    <article class="animate">
      <Content />
    </article>
  </Container>
</PageLayout>
