---
interface Props {
  project: any;
}

const { project } = Astro.props;
const { data, slug, id } = project;

// Derive language from the entry id (more reliable than slug)
// Example id values: `en/corn-n` or `fr/corn-n` depending on collection layout
const langPrefix = id && id.startsWith('fr/') ? '/fr' : '';
// Remove language prefix from slug for the URL
const projectSlug = slug.replace(/^(en|fr)\//, '');
---

<a
  href={`${langPrefix}/projects/${projectSlug}`}
  class="group block rounded-xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 overflow-hidden hover:border-tangent-400 dark:hover:border-tangent-500 transition-colors"
>
  <!-- Project Image -->
  <div class="aspect-[2/1] overflow-hidden bg-stone-100 dark:bg-stone-950 border-b border-stone-200 dark:border-stone-800">
    {data.image ? (
      <img
        src={data.image}
        alt={data.title}
        class="w-full h-full object-contain p-5"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center">
        <svg
          class="w-16 h-16 opacity-20"
          fill="none" 
          stroke="currentColor" 
          viewBox="0 0 24 24"
        >
          <path 
            stroke-linecap="round" 
            stroke-linejoin="round" 
            stroke-width="2" 
            d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
          />
        </svg>
      </div>
    )}
  </div>

  <!-- Project Content -->
  <div class="p-6 space-y-3">
    <div class="flex items-start justify-between gap-2">
      <h3 class="font-sans text-xl font-semibold text-stone-900 dark:text-white group-hover:text-tangent-700 dark:group-hover:text-tangent-400 transition-colors">
        {data.title}
      </h3>
      <svg 
        class="w-5 h-5 flex-shrink-0 mt-1 opacity-50 group-hover:translate-x-1 group-hover:opacity-100 transition-all" 
        fill="none" 
        stroke="currentColor" 
        viewBox="0 0 24 24"
      >
        <path 
          stroke-linecap="round" 
          stroke-linejoin="round" 
          stroke-width="2" 
          d="M9 5l7 7-7 7"
        />
      </svg>
    </div>

    {data.description && (
      <p class="text-sm text-stone-600 dark:text-stone-400 line-clamp-2">
        {data.description}
      </p>
    )}

    {data.tech && data.tech.length > 0 && (
      <div class="flex flex-wrap gap-1.5 pt-2 font-sans">
        {data.tech.slice(0, 4).map((tech: string) => (
          <span class="text-[11px] px-2 py-0.5 rounded bg-stone-100 dark:bg-stone-800 text-stone-600 dark:text-stone-300">
            {tech}
          </span>
        ))}
        {data.tech.length > 4 && (
          <span class="text-[11px] px-2 py-0.5 text-stone-400">
            +{data.tech.length - 4}
          </span>
        )}
      </div>
    )}
  </div>
</a>
