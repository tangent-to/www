---
import type { CollectionEntry } from "astro:content";

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
}

const { entry } = Astro.props;

// Entries live in `en/` or `fr/` folders. Build a language-correct URL.
const langPrefix = entry.id.startsWith("fr/") ? "/fr" : "";
const slug = entry.slug.replace(/^(en|fr)\//, "");
const href = `${langPrefix}/${entry.collection}/${slug}`;
---

<a href={href} class="relative group flex flex-nowrap py-4 px-5 pr-10 rounded-xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 hover:border-tangent-400 dark:hover:border-tangent-500 transition-colors duration-300 ease-in-out">
  <div class="flex flex-col flex-1 truncate">
    <div class="font-sans font-semibold text-stone-900 dark:text-white group-hover:text-tangent-700 dark:group-hover:text-tangent-400 transition-colors">
      {entry.data.title}
    </div>
    <div class="text-sm text-stone-600 dark:text-stone-400 truncate">
      {entry.data.description}
    </div>
  </div>
  <svg 
    xmlns="http://www.w3.org/2000/svg" 
    viewBox="0 0 24 24"
    class="absolute top-1/2 right-2 -translate-y-1/2 size-5 stroke-2 fill-none stroke-current">
    <line x1="5" y1="12" x2="19" y2="12" class="translate-x-3 group-hover:translate-x-0 scale-x-0 group-hover:scale-x-100 transition-transform duration-300 ease-in-out" />
    <polyline points="12 5 19 12 12 19" class="-translate-x-1 group-hover:translate-x-0 transition-transform duration-300 ease-in-out" />
  </svg>
</a>
